#!/usr/bin/env bash
# Wrapper para o Gradle/Android Studio encontrarem o Node (nvm não está no PATH da IDE).
set -euo pipefail

if [[ -n "${NODE_BINARY:-}" && -x "$NODE_BINARY" ]]; then
  exec "$NODE_BINARY" "$@"
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
fi

NODE="$(command -v node || true)"
if [[ -z "$NODE" ]]; then
  echo "Node.js não encontrado. Instale via nvm ou defina NODE_BINARY." >&2
  exit 1
fi

exec "$NODE" "$@"
